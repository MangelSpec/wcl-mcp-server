# Warcraft Logs V2 API credentials
# Create a confidential (NOT public) client at https://www.warcraftlogs.com/api/clients/
# and paste the Client ID and Client Secret here.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# --- Private log access (optional) ---
# Only needed if you want to read your own PRIVATE reports. Register this exact
# URI as a Redirect URI on the same WCL client above, then run `npm run auth`.
# Leave unset to use the default below; the server works fine without it and
# will read public/unlisted logs via client credentials.
# WCL_REDIRECT_URI=http://localhost:4477/callback

# Where the user token from `npm run auth` is stored.
# Defaults to ~/.wcl-mcp/token.json. Set this if your MCP client launches the
# server as a different OS user than the one that ran `npm run auth`.
# WCL_TOKEN_FILE=
